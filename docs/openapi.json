{
  "openapi": "3.1.0",
  "info": {
    "title": "BUP Fuel Operations Snapshot API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/snapshot": {
      "get": {
        "summary": "Get Snapshot",
        "description": "Reads the official simulator's current tick, inventory in liters, and routes. Retries a read if the simulator changes during collection.",
        "operationId": "getSnapshot",
        "responses": {
          "200": {
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "502": {
            "description": "Simulator response failed schema validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotError"
                }
              }
            }
          },
          "503": {
            "description": "Simulator is unavailable, reports stale data, or changed during every read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotError"
                }
              }
            }
          }
        }
      }
    },
    "/api/planning": {
      "get": {
        "summary": "Get Planning Report",
        "description": "Projects station demand from recent history with seasonality/event awareness, detects anomalies and bottlenecks, activates safety reorder fallback when history is incomplete, and ranks standalone shipment alternatives by urgency-weighted unmet demand avoided.",
        "operationId": "getPlanningReport",
        "parameters": [
          {
            "name": "history_ticks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 96,
              "minimum": 1,
              "description": "Completed ticks used for the rolling mean.",
              "default": 8,
              "title": "History Ticks"
            },
            "description": "Completed ticks used for the rolling mean."
          },
          {
            "name": "horizon_ticks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 288,
              "minimum": 1,
              "description": "Number of ticks to project from the current tick.",
              "default": 96,
              "title": "Horizon Ticks"
            },
            "description": "Number of ticks to project from the current tick."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanningReport"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "502": {
            "description": "Simulator response failed schema validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotError"
                }
              }
            }
          },
          "503": {
            "description": "Simulator is unavailable, reports stale data, or changed during every read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotError"
                }
              }
            }
          }
        }
      }
    },
    "/api/approvals/{intent_id}": {
      "put": {
        "summary": "Approve",
        "description": "Approve or retry an exact shipment intent. The response reports its persisted outcome.",
        "operationId": "submitApproval",
        "parameters": [
          {
            "name": "intent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Intent Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Proposal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalAttempt"
                }
              }
            }
          },
          "409": {
            "description": "The intent ID already belongs to a different shipment payload."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/approvals": {
      "get": {
        "summary": "Approvals",
        "description": "Lists durable approval attempts and reconciles simulator shipment statuses when fresh.",
        "operationId": "listApprovals",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalLedger"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get Health",
        "description": "Reports component health for the backend API, SQLite ledger, simulator, SSE stream, and intelligence modules.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "503": {
            "description": "One or more critical components are degraded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Get Metrics",
        "description": "Returns application request latency percentiles, error rate, intelligence fallback/anomaly counts, SSE counters, and upstream simulator metrics.",
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsReport"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Anomaly": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "DEMAND_SPIKE",
              "DEMAND_DROP",
              "STOCKOUT_RISK",
              "ROUTE_DISRUPTED",
              "STATION_OUTAGE",
              "DEPOT_CONSTRAINED",
              "DISPATCH_BOTTLENECK",
              "SUPPLY_DELAYED"
            ],
            "title": "Category"
          },
          "severity": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "WARNING"
            ],
            "title": "Severity"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "station",
              "depot",
              "route",
              "supply"
            ],
            "title": "Entity Type"
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "title": "Entity Id"
          },
          "fuel_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "DIESEL",
                  "PETROL",
                  "OCTANE"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Fuel Type"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "observed_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Value"
          },
          "baseline_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Value"
          },
          "z_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Z Score"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "entity_type",
          "entity_id",
          "summary"
        ],
        "title": "Anomaly"
      },
      "ApprovalAttempt": {
        "properties": {
          "intent_id": {
            "type": "string",
            "title": "Intent Id"
          },
          "proposal": {
            "$ref": "#/components/schemas/ShipmentPayload"
          },
          "state": {
            "type": "string",
            "enum": [
              "READY",
              "UNKNOWN",
              "CONFIRMED",
              "REJECTED"
            ],
            "title": "State"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "shipment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Shipment"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "intent_id",
          "proposal",
          "state",
          "message",
          "shipment"
        ],
        "title": "ApprovalAttempt"
      },
      "ApprovalLedger": {
        "properties": {
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/ApprovalAttempt"
            },
            "type": "array",
            "title": "Attempts"
          },
          "simulator_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
