              }
            ],
            "title": "Demand Liters Per Tick"
          },
          "stockout_tick": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stockout Tick"
          },
          "unmet_liters": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Unmet Liters"
          },
          "projected_demand_liters_per_tick": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Projected Demand Liters Per Tick"
          },
          "fallback_demand_liters_per_tick": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Demand Liters Per Tick"
          },
          "demand_std_liters": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "title": "Demand Std Liters"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ],
            "title": "Confidence",
            "default": "LOW"
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score",
            "default": 0
          },
          "shortage_risk": {
            "type": "string",
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ],
            "title": "Shortage Risk",
            "default": "UNKNOWN"
          },
          "stockout_probability": {
            "type": "number",
            "title": "Stockout Probability",
            "default": 0
          },
          "fallback_used": {
            "type": "boolean",
            "title": "Fallback Used",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "station_id",
          "station_name",
          "fuel_type",
          "observations",
          "first_history_tick",
          "last_history_tick",
          "demand_liters_per_tick",
          "stockout_tick",
          "unmet_liters"
        ],
        "title": "Forecast"
      },
      "FuelVolumes": {
        "properties": {
          "DIESEL": {
            "type": "number",
            "minimum": 0,
            "title": "Diesel"
          },
          "PETROL": {
            "type": "number",
            "minimum": 0,
            "title": "Petrol"
          },
          "OCTANE": {
            "type": "number",
            "minimum": 0,
            "title": "Octane"
          }
        },
        "type": "object",
        "required": [
          "DIESEL",
          "PETROL",
          "OCTANE"
        ],
        "title": "FuelVolumes"
      },
      "HTTPValidationError": {
