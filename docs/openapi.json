          },
          "route_id": {
            "type": "string",
            "minLength": 1,
            "title": "Route Id"
          },
          "fuel_type": {
            "type": "string",
            "enum": [
              "DIESEL",
              "PETROL",
              "OCTANE"
            ],
            "title": "Fuel Type"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "source_depot_id",
          "destination_station_id",
          "route_id",
          "fuel_type",
          "quantity"
        ],
        "title": "Proposal"
      },
      "Recommendation": {
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1,
            "title": "Route Id"
          },
          "source_depot_id": {
            "type": "string",
            "minLength": 1,
            "title": "Source Depot Id"
          },
          "source_depot_name": {
            "type": "string",
            "title": "Source Depot Name"
          },
          "destination_station_id": {
            "type": "string",
            "minLength": 1,
            "title": "Destination Station Id"
          },
          "destination_station_name": {
            "type": "string",
