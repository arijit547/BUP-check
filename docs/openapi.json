              "OPEN",
              "CONSTRAINED"
            ],
            "title": "Status"
          },
          "dispatch_capacity_per_tick": {
            "type": "number",
            "minimum": 0,
            "title": "Dispatch Capacity Per Tick"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "region_id",
          "inventory",
          "capacity",
          "status",
          "dispatch_capacity_per_tick"
        ],
        "title": "Depot"
      },
      "Forecast": {
        "properties": {
          "station_id": {
            "type": "string",
            "minLength": 1,
            "title": "Station Id"
          },
          "station_name": {
            "type": "string",
            "title": "Station Name"
          },
          "fuel_type": {
            "type": "string",
            "enum": [
              "DIESEL",
              "PETROL",
              "OCTANE"
            ],
            "title": "Fuel Type"
          },
          "observations": {
            "type": "integer",
            "title": "Observations"
          },
          "first_history_tick": {
            "anyOf": [
