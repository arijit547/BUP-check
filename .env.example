# Host ports (loopback-only by default in compose.yaml)
SIMULATOR_PORT=8000
SNAPSHOT_PORT=8001
DASHBOARD_PORT=3000

# Simulator configuration
SIMULATION_SPEED=8
TICK_MINUTES=15
SIMULATOR_START_MODE=paused

# Backend configuration
PLANNING_CACHE_TTL_SECONDS=2.0
SIMULATOR_TIMEOUT_SECONDS=3.0
ML_FORECAST_TIMEOUT_SECONDS=8.0
# Set to http://ml-service:8002 when running with compose.ml.yaml (--profile ml)
ML_SERVICE_URL=

# Optional operator authentication (disabled on loopback by default when hashes are empty)
# Generate hash via: python -c "from backend.security import create_pbkdf2_hash; print(create_pbkdf2_hash('choose-password'))"
OPERATOR_AUTH_MODE=local_open
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=
OPERATOR_TOKEN_SHA256=
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional monitoring ports
PROMETHEUS_PORT=9090
